<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Winwright.InApp</RootNamespace>
    <AssemblyName>Winwright.InApp</AssemblyName>

    <!-- The in-app half draws, so it needs the presentation stack. The engine does not: it reads
         trees and copies rectangles, and the two halves are separate assemblies precisely so an
         application takes the one it needs without inheriting the other. -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!-- WW122: this is the half an application under test takes, so it has to be takeable. A project
       reference into this repository is unpinnable by construction - which the agreement check
       already says out loud - and an application shipping to its users cannot take one at all.

       WW230 answered where it goes: nuget.org, published from .github/workflows/publish.yml on a
       tag. Until then a folder in this tree was the only place either half existed, which meant an
       adopter's restore needed a path into this repository - the shape block I's criterion forbids
       and samples/Adopter exists to disprove. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Winwright.InApp</PackageId>
    <Title>Winwright, the in-app half</Title>
    <Description>What an application under test takes so a harness can read it: dispatcher-bounded
      work, shareable brushes, per-monitor coordinates, a background nobody can leave transparent,
      and a geometry dump. No reference to the engine, so nothing here ships a test harness to an
      application's users.</Description>
    <PackageTags>ui-automation;wpf;testing;windows</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Same repair as the engine: UseWPF swaps the SDK's implicit global usings for WPF's set, and
       System.IO is not in that set. -->
  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <!-- No reference to Winwright, and that is the point rather than an omission. This package is
       taken by the application under test; the engine is taken by the harness driving it, and an
       application that referenced the engine would ship a test harness to its users. -->

</Project>
