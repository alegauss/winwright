<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Winwright</RootNamespace>
    <AssemblyName>Winwright</AssemblyName>

    <!-- WW16. This is the documented way to reach UIAutomationClient and UIAutomationTypes, which
         are in-box in the Windows Desktop framework. The locator grammar validates a control type
         and a pattern name against UI Automation's own vocabulary rather than against a list kept
         here by hand, and a list kept by hand is a list that drifts from the thing it describes. -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!-- WW122: the harness half. Packed for the same reason as the in-app half and taken by a
       different party - this one by whoever drives the application, never by the application. What
       makes the pair worth packing is the agreement check: a version read off a package reference
       is a version, and one read off a path is whatever the tree it was built from happened to be. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Winwright</PackageId>
    <Title>Winwright</Title>
    <Description>Drives a Windows desktop application through UI Automation and answers in three
      verdicts rather than two, so a check that could not run is never reported as one that passed.
      No external dependency, and nothing here belongs in the application under test.</Description>
    <PackageTags>ui-automation;wpf;testing;windows</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- WW230. The one page an adopter reads before deciding, and the tree's own README rather than a
         second one written for the package: a description kept twice is the one that goes on saying
         the old thing after the first moves. -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Turning UseWPF on swaps the SDK's implicit global usings for WPF's set, and System.IO is
       not in that set: the tracing and project files stopped compiling the moment the property
       above was added. Naming it back is the whole repair, and it is written down here because
       the error it causes says nothing about WPF. -->
  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <!-- No PackageReference here, and that is a non-goal rather than an omission: a package in the
       engine is a package every adopting project inherits. -->

</Project>
