<!-- ShowActivated is False deliberately. An application somebody launched should take the desk;
     one a suite raises thirty times a run must not, or it decides who owns the foreground for
     every check that runs after it. Everything the fixture is for survives being unactivated: it
     is on screen, composed, enumerable and readable through the tree. -->
<Window x:Class="Winwright.Fixture.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="winwright fixture"
        Width="640" Height="420"
        WindowStartupLocation="Manual"
        Left="80" Top="80"
        ShowActivated="False"
        ResizeMode="CanResize"
        Background="{StaticResource Surface}">

  <!-- Every control here carries a name, because the whole point of the fixture is that a locator
       can be written against it and stay written. A surface addressed only by its position is one
       every layout change breaks. -->
  <Grid x:Name="page" Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock x:Name="heading" Grid.Row="0" Text="winwright fixture" FontSize="22" />

    <TextBlock x:Name="subheading" Grid.Row="1" Margin="0,4,0,12" FontSize="13"
               Text="A window that belongs to this repository. No account, no transcripts, no second machine." />

    <TabControl x:Name="panes" Grid.Row="2" BorderBrush="{StaticResource Line}">
      <TabItem x:Name="reportPane" Header="Report">
        <StackPanel x:Name="reportRows" Margin="12">
          <TextBlock x:Name="reportTitle" Text="Report" FontSize="16" Margin="0,0,0,8" />

          <!-- Collapsed unless the loading flag asks for it, and it takes the real content's place
               rather than sitting beside it: a page that shows both is not a page still loading. -->
          <TextBlock x:Name="loadingNote" Text="Still loading" Visibility="Collapsed" />
          <TextBlock x:Name="reportNote"
                     Text="Every value on this page is fixed by construction: no clock, no machine name, no real data."
                     TextWrapping="Wrap" />
          <!-- On the pane that is showing, deliberately. A label a case has to open a tab to read
               is a label the case has to know a tab about, and the rule is about the label. -->
          <TextBlock x:Name="localizedLabel" Margin="0,8,0,0" />
          <Border x:Name="reportSwatch" Height="60" Margin="0,12,0,0" Background="{StaticResource Accent}" />
        </StackPanel>
      </TabItem>

      <TabItem x:Name="statusPane" Header="Status">
        <StackPanel x:Name="statusRows" Margin="12">
          <TextBlock x:Name="statusTitle" Text="Status" FontSize="16" Margin="0,0,0,8" />
          <TextBlock x:Name="statusValue" Text="Idle" />

          <!-- Empty unless the animate flag asks for it. Each state announces its own place, so a
               check reads the count off the window rather than being told it. -->
          <TextBlock x:Name="animationState" Margin="0,8,0,0" />
        </StackPanel>
      </TabItem>

      <TabItem x:Name="configPane" Header="Config">
        <StackPanel x:Name="configRows" Margin="12">
          <TextBlock x:Name="configTitle" Text="Config" FontSize="16" Margin="0,0,0,8" />
          <TextBox x:Name="profile" Width="220" HorizontalAlignment="Left" Text="default" />
          <CheckBox x:Name="verbose" Margin="0,12,0,0" Content="Verbose" />

          <!-- WW249. Every WM_CHAR this window is delivered, in order, below WPF entirely. It is
               what separates a send that arrived already wrong from a text box that dropped one
               under load, and those are opposite repairs in opposite repositories. -->
          <TextBlock x:Name="arrived" Margin="0,12,0,0" TextWrapping="Wrap" Text="nothing yet" />

          <!-- WW249. The key each character was injected as, beside the character it became. Six
               reds put the defect in the send, and the send is still two things: what SendInput was
               given, and what TranslateMessage made of what arrived. These two captions are what
               tell those apart. -->
          <TextBlock x:Name="injected" Margin="0,8,0,0" TextWrapping="Wrap" Text="nothing yet" />

          <!-- WW312. How long each character waited behind the one before it, as the window's own
               thread pulled it off the queue. Everything measured about WW249 so far is on the
               sending side, and the fault is a character ARRIVING where a different one was sent -
               so this is the end nothing had read. -->
          <TextBlock x:Name="waited" Margin="0,8,0,0" TextWrapping="Wrap" Text="nothing yet" />
        </StackPanel>
      </TabItem>
    </TabControl>

    <StackPanel x:Name="actions" Grid.Row="3" Orientation="Horizontal"
                HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="save" Content="Save" Width="90" Height="28" />
      <Button x:Name="close" Content="Close" Width="90" Height="28" Margin="8,0,0,0" Click="OnClose" />
    </StackPanel>
  </Grid>
</Window>
