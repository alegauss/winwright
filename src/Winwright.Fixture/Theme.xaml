<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <!-- Fixed by construction. Nothing here reads a theme, a clock, a machine name or a setting,
         because the whole value of this fixture is that two runs on two desks draw the same
         pixels — a byte-identical comparison has nothing to be identical to otherwise. -->
    <SolidColorBrush x:Key="Surface" Color="#FFF6F8FA" />

    <!-- The key the in-app half looks for. Declared here rather than left to the fallback, because
         the fallback reads the window's own brush and a capture of a page is not a capture of a
         window - an adopting project copying this file is copying the answer to that. -->
    <SolidColorBrush x:Key="WinwrightCaptureBackground" Color="#FFF6F8FA" />
    <SolidColorBrush x:Key="Ink" Color="#FF1F2328" />
    <SolidColorBrush x:Key="Accent" Color="#FF1F6FEB" />
    <SolidColorBrush x:Key="Line" Color="#FFD0D7DE" />

    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

</ResourceDictionary>
