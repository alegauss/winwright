<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Winwright.Fixture</RootNamespace>
    <AssemblyName>Winwright.Fixture</AssemblyName>
    <UseWPF>true</UseWPF>

    <!-- WW358. One shape needs WinForms and nothing else here touches it: a tray application's menu
         is a ToolStripDropDown, and the shadow Windows draws behind one is a separate SysShadow
         window two pixels larger on every side. Measured rather than assumed: a WPF popup draws its
         own shadow into its own layer (WW347) and produces no such window, so WPF cannot reproduce
         the surface at all. Nothing here is loaded unless the shadowed shape is asked for. -->
    <UseWindowsForms>true</UseWindowsForms>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- There is no App.xaml, and that is the point: an ApplicationDefinition generates its own
       entry point, and this project needs its own. A flag the fixture does not know has to be
       refused before the presentation stack starts - refusing from inside Startup leaves a message
       loop running with no window to close, and the process hangs until something kills it. The
       resources live in a dictionary the application merges instead. -->
  <PropertyGroup>
    <StartupObject>Winwright.Fixture.Program</StartupObject>
  </PropertyGroup>

  <!-- WW358. The reference stays and the implicit using goes. Enabling WinForms puts its namespace
       into every file's global usings, and this is a WPF application: the panes here name Button,
       ComboBox, TabControl and GroupBox, all four of which exist in both toolkits, and seventeen
       files went ambiguous on the build that found it. System.Drawing goes for the same reason and
       was found the same way: Size is in it and in System.Windows. The one file that wants either
       says so at its own top, which is where a reader of that file is looking anyway. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- The in-app half, which is what an adopting application takes. Not the engine: that is the
       harness driving this, and an application referencing it would ship a test harness to its
       users. This fixture is the reference for what an adopter does, so it takes what they take. -->
  <ItemGroup>
    <ProjectReference Include="../Winwright.InApp/Winwright.InApp.csproj" />
  </ItemGroup>

  <!-- The strings, beside the executable. Several languages because the label rule cannot be
       developed against one, and one of them carrying a key whose value has a placeholder because
       that is the case an exact-name read can never match and must refuse rather than skip. -->
  <ItemGroup>
    <Content Include="strings/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- No reference to the engine, and that is the whole of the separation. -->

</Project>
