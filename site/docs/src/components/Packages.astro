---
// The package references an adopter pastes, at the version they can actually restore.
//
// What renders is `docs/src/data/product.generated.json`, which `scripts/product.mjs` writes
// from `Directory.Build.props` and the two packable csproj files. A version typed onto this
// page would be right on the day it was typed and would then send every reader after the next
// release to a package that is a version behind — the exact hazard the concordance check
// exists for, arriving through the documentation instead.
//
// WW506: and generated is not enough either. The site deploys on `workflow_dispatch` and
// publishing a release does not trigger it, so the two drift by construction — this block was
// right on the day it was built and a version behind from the next release onward, on the one
// line somebody copies into a csproj. So the browser asks nuget.org and swaps the number where
// the feed answers with a better one.
//
// The generated number is what the page ships. A reader offline, behind a proxy, or with
// JavaScript off sees exactly what they see today, and the number they see is never one this
// invented — the picker answers null for every way of not knowing.
import { Code } from "@astrojs/starlight/components";

import product from "../data/product.generated.json";

interface Props {
  /** One half, or both with the comment that says which project each goes in. */
  half?: "harness" | "app";
}

const { half } = Astro.props;

const lineFor = (takenBy: "harness" | "app"): string => {
  const found = product.packages.find((one) => one.takenBy === takenBy);
  if (!found) {
    // The payload comes off the csproj files, so a half missing from it is a rename nobody
    // followed through. Failing the build is the whole reason the figures are generated.
    throw new Error(`[packages] the product declares no package taken by the ${takenBy}`);
  }
  return `<PackageReference Include="${found.id}" Version="${product.version}" />`;
};

const code = half
  ? lineFor(half)
  : [
      "<!-- In the test project that drives the application. -->",
      lineFor("harness"),
      "",
      "<!-- In the application under test, only if you want the readings it can only take",
      "     from inside the process. -->",
      lineFor("app"),
    ].join("\n");
---

<div class="ww-packages" data-built={product.version} data-asks={product.packages.map((one) => one.id).join(" ")}>
  <Code lang="xml" code={code} />
</div>

<script>
  // The one picker, imported rather than copied: `src/lib/nuget-feed.ts` is this same module
  // with types over it, and the comparison inside it — a numeric prerelease counter, a release
  // outranking a prerelease of the same core — is where the real failure lives.
  import { fetchLatestPublished } from "../../../scripts/nuget-feed.mjs";

  // WW510. The asking and the rewriting both live in `scripts/swap-version.mjs`, because an
  // inline script is the one thing on this site no run could reach — the selector, the data
  // attributes, the request per id, the promise and the swap were all unwatched. They are a
  // function a case runs over the page this build wrote, and what is left here is the feed.
  import { swapEveryBlock } from "../../../scripts/swap-version.mjs";

  void swapEveryBlock(document, (id) => fetchLatestPublished(id));
</script>
