<Project Sdk="Microsoft.NET.Sdk">

  <!-- WW66: the tools the plugin carries. Its own process because that is what a stdio MCP server
       is - the harness launches it and talks JSON-RPC over the two pipes - and it answers off the
       engine's own schema rather than off a second copy of the format written here. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Paneproof.Mcp</RootNamespace>
    <AssemblyName>Paneproof.Mcp</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Paneproof\Paneproof.csproj" />
  </ItemGroup>

</Project>
