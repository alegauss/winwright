<Project>

  <!-- WW1: every project in this tree targets the Windows Desktop framework, because the engine's
       only dependencies are UIAutomationClient and UIAutomationTypes, which are in-box there.
       Setting it once here is what keeps a later project from quietly targeting something else. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <!-- WW15: this tool reasons about which language an application resolved, so it needs real
         cultures. Under invariant globalization pt-BR is not a culture that can be constructed,
         and the one comparison this project exists to make would be unmakeable. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
