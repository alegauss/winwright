<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Winwright.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- xUnit lives here and never in the engine: the non-goal is about what an adopting project
       inherits, and nobody inherits a test project. That it has no vocabulary for the third
       verdict is why WW1 exists; it is still the right harness for testing the vocabulary. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Winwright/Winwright.csproj" />
    <ProjectReference Include="../../src/Winwright.InApp/Winwright.InApp.csproj" />

    <!-- WW117: the roll call runs after the host, including after one that died, so it is its own
         process - and its arithmetic is checked here, because a check nobody tests is no check. -->
    <ProjectReference Include="../../tools/Winwright.RollCall/Winwright.RollCall.csproj" />

    <!-- WW142: the agreement gate reads a command line, and a flag it silently dropped is a copy
         that left the reading without lowering the count anybody sees. That is checked here. -->
    <ProjectReference Include="../../tools/Winwright.Concordance/Winwright.Concordance.csproj" />

    <!-- WW66: the tools answer off the engine's own schema, and what says so is a suite that calls
         the dispatch directly. A server tested only by launching it is a server whose answers are
         checked as often as somebody opens a session. -->
    <ProjectReference Include="../../tools/Winwright.Mcp/Winwright.Mcp.csproj" />

    <!-- WW67: the guard denies a write, so every one of its judgements is a false deny waiting to
         happen. What it allows is checked here as carefully as what it refuses. -->
    <ProjectReference Include="../../tools/Winwright.Guard/Winwright.Guard.csproj" />

    <!-- Referenced so the suite builds the fixture, and copied nowhere: an application under
         test is launched from its own output, not from a half-copy beside the suite. Copying it
         brought the apphost without its assembly and every launch died at CLR startup. -->
    <ProjectReference Include="../../src/Winwright.Fixture/Winwright.Fixture.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!-- WW138: a bare `dotnet test` takes the roll. It landed as a step in the workflow and a script
       at the root, and every developer runs the command every .NET project has instead - getting
       the same pass the check exists to withdraw. A check that has to be invoked separately is not
       a check the project has, it is a check the project offers. -->
  <PropertyGroup>
    <RollCall Condition="'$(RollCall)' == ''">true</RollCall>

    <!-- WW150: a directory per run, and never one directory however many runs. Both files used to
         default to TestResults itself, so a developer running the suite while an agent ran it in
         another shell had each roll call reading one run's listing against the other's results -
         which comes out as names discovered and never recorded, the exact shape of a host that
         died. A check invented to stop a false green would have produced a false red, and the
         reader's correct response to it is to run it again: the habit this whole thing exists to
         break.
         A directory and not a lock: a lock makes the second run wait for the first, which is
         slower and still wrong if either is killed.
         The stamp carries milliseconds and six hex, so two runs started a second apart cannot
         collide. A caller may name its own - the VM runner does, because it has to copy the files
         back out of the guest by an exact path and cannot guess a stamp - and a caller that names
         it owns keeping it unique. -->
    <RollCallRun Condition="'$(RollCallRun)' == ''">$([System.DateTime]::UtcNow.ToString('yyyyMMdd-HHmmss-fff'))-$([System.Guid]::NewGuid().ToString('N').Substring(0, 6))</RollCallRun>
    <RollCallResults>$(MSBuildThisFileDirectory)..\..\TestResults\$(RollCallRun)</RollCallResults>

    <!-- WW289. The root every run keeps its ledger under, so this run's excuses can be said beside
         the run before it. Held as its own property because the roll is passed the root and finds
         the predecessor itself - MSBuild enumerating directories and picking the latest would put
         the choosing in a place no test can reach.

         Overridable, and that is the whole of what makes it work in the guest: the VM runner deletes
         and re-extracts the repository tree every run, so a history under this repository's own
         TestResults is gone before the next run can read it, and every guest run would report no
         earlier run forever. The runner sets this to a directory outside the tree it wipes, the same
         way WW150 sets RollCallRun - as an environment variable, which MSBuild reads as a property,
         so the guest still types the command a developer types. -->
    <RollCallRoot Condition="'$(RollCallRoot)' == ''">$(MSBuildThisFileDirectory)..\..\TestResults</RollCallRoot>
    <RollCallTool>$(MSBuildThisFileDirectory)..\..\tools\Winwright.RollCall\bin\$(Configuration)\$(TargetFramework)\Winwright.RollCall.dll</RollCallTool>

    <!-- A run writes no results file unless somebody asks for one, and the roll reads results. So
         the default is to ask; naming a logger on the command line still wins. -->
    <VSTestLogger Condition="'$(VSTestLogger)' == '' and '$(RollCall)' == 'true'">trx%3bLogFileName=winwright.trx</VSTestLogger>
    <VSTestResultsDirectory Condition="'$(VSTestResultsDirectory)' == '' and '$(RollCall)' == 'true'">$(RollCallResults)</VSTestResultsDirectory>
  </PropertyGroup>

  <!-- Skipped where a filter was given, and that is not a convenience: a filtered run is short of
       discovery on purpose, and reporting it as a lost host is the false red that would get the
       whole thing turned off. `-p:RollCall=false` is the switch for everything else. -->
  <Target Name="TakeTheRoll"
          AfterTargets="VSTest"
          Condition="'$(RollCall)' == 'true' and '$(VSTestTestCaseFilter)' == ''">

    <!-- Made before the redirect writes into it. The results directory is this run's own now, so
         it exists only because VSTest happened to write the trx there first - which is true today
         and is not a thing to depend on one target away. -->
    <MakeDir Directories="$(RollCallResults)" />

    <!-- Discovery from the assembly that was just run, and never a second build. RollCall=false on
         the inner call because listing the tests runs this target again otherwise. -->
    <Exec Command="dotnet test &quot;$(MSBuildProjectFullPath)&quot; --no-build --configuration $(Configuration) -p:RollCall=false --list-tests &gt; &quot;$(RollCallResults)\discovered.txt&quot;"
          StandardOutputImportance="low" />

    <!-- Captured rather than left to fail on its own: MSBuild's own words for a command that
         exited non-zero are "the command exited with code 1", and this block's criterion is that a
         degraded run is legible without reading the log. What the roll said is the legible part. -->
    <!-- WW231: the excused flag names the ledger BusyDesk writes beside this assembly. Passing it is
         the asking, so a run that wrote no ledger is reported as unknown rather than as a clean run.
         $(TargetDir) and not the results directory: the suite writes it from inside its own process,
         which knows where its assembly is and nothing about the name this run was given.

         The flag is described rather than spelled, because an XML comment cannot carry two hyphens in
         a row and this file refused to load with MSB4025 over exactly that. -->
    <Exec Command="dotnet exec &quot;$(RollCallTool)&quot; --discovered &quot;$(RollCallResults)\discovered.txt&quot; --results &quot;$(RollCallResults)\winwright.trx&quot; --excused &quot;$(TargetDir)excused.txt&quot; --against &quot;$(RollCallRoot)&quot; 2&gt;&amp;1"
          IgnoreExitCode="true"
          ConsoleToMSBuild="true"
          StandardOutputImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="RollCallExit" />
      <Output TaskParameter="ConsoleOutput" ItemName="RollCallSaid" />
    </Exec>

    <!-- WW289: this run's ledger kept for the run after this one, because $(TargetDir) holds one
         ledger that every run truncates - the count is only still on disk if somebody puts a copy
         somewhere named for the run that produced it.

         After the roll and never before it: the roll reads this root for a predecessor, and a ledger
         filed under this run's own name while it is still being taken is a run comparing itself with
         itself and finding nothing changed. Conditional because a run that excused nothing writes no
         ledger at all, which is a copy that would otherwise fail on the cleanest run there is. -->
    <Copy SourceFiles="$(TargetDir)excused.txt"
          DestinationFolder="$(RollCallRoot)\$(RollCallRun)"
          Condition="Exists('$(TargetDir)excused.txt')" />

    <Error Condition="'$(RollCallExit)' != '0'"
           Code="WW117"
           Text="the roll call refused this run: @(RollCallSaid, '%0A')" />

    <Message Condition="'$(RollCallExit)' == '0'" Importance="high" Text="@(RollCallSaid, '%0A')" />
  </Target>

  <!-- WW297. The way in that reaches the roll on both verdicts, and the reason it exists is
       measured: a target hung on AfterTargets="VSTest" is skipped where VSTest failed, so the roll
       went silent on exactly the runs whose reading is hardest - a red run that also excused forty
       checks said only that one test failed.

       CallTarget and not DependsOnTargets, which is the whole mechanism: OnError runs where a TASK
       in this target failed, and CallTarget is a task. A dependency that fails never starts the
       target that depends on it, and OnError would never be reached.

       Both verdicts, once each. Green: CallTarget succeeds and TakeTheRoll fires through its own
       AfterTargets, measured to still fire under CallTarget. Red: AfterTargets is skipped and
       OnError runs it instead. The two cannot both happen, so the roll is never taken twice.

       OnError does not swallow what failed - measured, exit 1 - and it must not. The suite's verdict
       is the headline and the exit code belongs to it; the roll is a second sentence printed beside
       a red run, never a thing that changes what the run concluded. -->
  <Target Name="TestAndRoll">
    <CallTarget Targets="VSTest" />
    <OnError ExecuteTargets="TakeTheRoll" />
  </Target>

</Project>
