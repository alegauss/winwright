<?xml version="1.0" encoding="utf-8"?>
<!-- WW122: the adopter restores from whatever this repository just packed and from nowhere else.
     Publishing to a feed is a decision nobody here has made, and a package an adopter references
     from a local folder is still a package - which is the whole claim being proved. -->
<configuration>
  <packageSources>
    <clear />
    <add key="local" value="../../packages" />
  </packageSources>
</configuration>
