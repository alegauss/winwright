<?xml version="1.0" encoding="utf-8"?>
<!-- WW122: the adopter restores from whatever this repository just packed and from nowhere else.

     It stays that way after WW230 published the halves to nuget.org, and that is the point rather
     than a leftover: what this sample proves is that one package reference reaches the in-app half,
     and a restore from nuget.org would prove that about a version published earlier instead of about
     the tree it is standing in. A type public here and missing from the package has to fail in the
     same run that built it. The adopter that proves the other claim - no path into this repository -
     is the real one, in claude-tray. -->
<configuration>
  <packageSources>
    <clear />
    <add key="local" value="../../packages" />
  </packageSources>
</configuration>
